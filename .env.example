# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Use hex password to avoid URL escaping in Compose DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql+psycopg://hourly:CHANGE_ME@localhost:5432/hourly
# Local HTTP only. For production HTTPS set 1.
COOKIE_SECURE=0
PUBLIC_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
